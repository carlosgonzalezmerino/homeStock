  "info": {
    "title": "homeStock",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Reports that the service is up.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/inventory": {
      "get": {
        "description": "Lists the tracked items with their product.\n\nArgs:\n    low: When true, only the items that need restocking are returned.\n    service: The inventory service.\n\nReturns:\n    Each item with its product and a flag that says whether it is low on stock.",
        "operationId": "list_inventory_api_inventory_get",
        "parameters": [
          {
            "in": "query",
            "name": "low",
            "required": false,
            "schema": {
              "default": false,
              "title": "Low",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InventoryWithProductOut"
                  },
                  "title": "Response List Inventory Api Inventory Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Inventory",
        "tags": [
          "inventory"
        ]
      },
      "post": {
        "description": "Starts tracking a product that is in the catalogue.\n\nArgs:\n    payload: The stock to store.\n    service: The inventory service.\n\nReturns:\n    The stored item.\n\nRaises:\n    HTTPException: 404 when the product is not in the catalogue, 409 when it is\n        already tracked, 422 when a freezer-only field is sent outside the freezer.",
        "operationId": "create_inventory_api_inventory_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Inventory",
        "tags": [
          "inventory"
        ]
      }
    },
    "/api/inventory/{ean}": {
      "delete": {
        "description": "Stops tracking a product. Its catalogue entry is kept.\n\nArgs:\n    ean: The product's barcode.\n    service: The inventory service.\n\nReturns:\n    An empty 204 response.\n\nRaises:\n    HTTPException: 404 when the product is not tracked.",
        "operationId": "delete_inventory_api_inventory__ean__delete",
        "parameters": [
          {
            "in": "path",
            "name": "ean",
            "required": true,
            "schema": {
              "title": "Ean",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Inventory",
        "tags": [
          "inventory"
        ]
      },
      "patch": {
        "description": "Edits the stock of a tracked product. Only the fields that are sent change.\n\nArgs:\n    ean: The product's barcode.\n    payload: The fields to change.\n    service: The inventory service.\n\nReturns:\n    The updated item.\n\nRaises:\n    HTTPException: 404 when the product is not tracked, 422 when a freezer-only\n        field would stay set outside the freezer.",
        "operationId": "patch_inventory_api_inventory__ean__patch",
        "parameters": [
          {
            "in": "path",
            "name": "ean",
            "required": true,
            "schema": {
              "title": "Ean",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Inventory",
        "tags": [
          "inventory"
        ]
      }
    },
    "/api/products": {
      "get": {
        "description": "Searches the catalogue by name or brand.\n\nArgs:\n    q: The text to look for.\n    repo: The product repository.\n\nReturns:\n    The matching products, up to a fixed limit.",
        "operationId": "search_products_api_products_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 100,
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductOut"
                  },
                  "title": "Response Search Products Api Products Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Products",
        "tags": [
          "products"
        ]
