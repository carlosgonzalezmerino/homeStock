{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "jinja": true,
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Frontend (Vite :5173)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "OFF import",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.off_import",
      "args": [
        "--csv",
        "data/en.openfoodfacts.org.products.csv"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ],
  "compounds": [
    {
      "name": "Backend + Frontend (dev)",
      "configurations": ["Backend (FastAPI :8000)", "Frontend (Vite :5173)"],
      "stopAll": true
    }
  ]
}
